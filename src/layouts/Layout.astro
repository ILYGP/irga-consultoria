---
interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Irga Consultoría | Soluciones Estratégicas", 
	description = "Asesoría estratégica, optimización de procesos y soluciones integrales a la medida de tu negocio." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--primary: #0f172a;
		--accent: #2563eb;
		--light: #f8fafc;
		--text: #334155;
		--font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
	}
	
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: var(--font-sans);
		background-color: var(--light);
		color: var(--text);
		scroll-behavior: smooth;
	}

	body {
		line-height: 1.6;
	}
</style>
