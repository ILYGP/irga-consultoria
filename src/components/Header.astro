---
---
<header class="site-header">
	<div class="container nav">
		<a href="#top" class="logo">
			<svg class="logo-icon" viewBox="0 0 190 120" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<polyline points="45,15 12,60 45,105" fill="none" stroke="#0f172a" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
				<polyline points="145,15 178,60 145,105" fill="none" stroke="#0f172a" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
				<text x="95" y="75" text-anchor="middle" font-family="system-ui, sans-serif" font-size="40" font-weight="800"><tspan fill="#0f172a">I</tspan><tspan fill="#1e40af">A</tspan></text>
			</svg>
			<span class="logo-text">
				<span class="t-navy">IRGA </span><span class="t-navy" style="font-weight:500;">Consultor</span><span class="t-accent">IA</span>
			</span>
		</a>
		<nav>
			<ul class="nav-links">
				<li><a href="#servicios">Servicios</a></li>
				<li><a href="#nosotros">Nosotros</a></li>
				<li><a href="#por-que-elegir">Ventajas</a></li>
				<li><a href="#contacto">Contacto</a></li>
			</ul>
		</nav>
		<a href="#contacto" class="btn btn-primary nav-cta">Hablemos</a>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(248, 250, 252, 0.9);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 18px 24px;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 800;
		font-size: 1.2rem;
		color: var(--primary);
	}
	.logo-icon { width: 30px; height: auto; flex-shrink: 0; }
	.t-navy { color: var(--primary); }
	.t-accent { color: var(--accent); }
	.nav-links {
		display: none;
		gap: 32px;
		list-style: none;
	}
	.nav-links a {
		color: var(--text-muted);
		font-weight: 500;
		font-size: 0.95rem;
	}
	.nav-links a:hover { color: var(--primary); }
	.nav-cta { display: none; }

	@media (min-width: 768px) {
		.nav-links { display: flex; }
		.nav-cta { display: inline-flex; }
	}
</style>
