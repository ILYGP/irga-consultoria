---
const services = [
	{
		icon: "🔍",
		title: "Diagnóstico y estrategia",
		description: "Te ayudamos a detectar en qué procesos la IA puede ahorrarte más tiempo y dinero, con un diagnóstico claro y sin tecnicismos.",
	},
	{
		icon: "⚙️",
		title: "Automatización de procesos",
		description: "Te ayudamos a automatizar tareas repetitivas —atención al cliente, inventario, facturación— para que ganes tiempo cada semana.",
	},
	{
		icon: "💬",
		title: "Chatbots y asistentes virtuales",
		description: "Te ayudamos a atender a tus clientes 24/7 por WhatsApp o tu sitio web, incluso cuando tú no puedes estar presente.",
	},
	{
		icon: "📈",
		title: "Marketing con IA",
		description: "Te ayudamos a crear contenido, campañas y presencia digital con herramientas de Inteligencia Artificial.",
	},
	{
		icon: "🎓",
		title: "Formación y capacitación",
		description: "Te ayudamos a que tu equipo use la IA en el día a día, con talleres prácticos y sin conocimientos técnicos previos.",
	},
	{
		icon: "🔧",
		title: "Implementación a medida",
		description: "Te ayudamos a integrar la IA en las herramientas que ya usas, adaptada a tu negocio real.",
	},
];
---
<section id="servicios">
	<div class="container">
		<span class="eyebrow">Qué hacemos</span>
		<h2>Servicios pensados para negocios reales</h2>
		<p class="section-intro">
			Sin jerga técnica ni promesas vacías: te ayudamos a implementar soluciones de IA
			que puedes entender, usar y medir desde el primer día.
		</p>
		<div class="services-grid">
			{services.map((service) => (
				<div class="service-card">
					<div class="service-icon">{service.icon}</div>
					<h3>{service.title}</h3>
					<p>{service.description}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 24px;
	}
	.service-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 32px 28px;
		transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
	}
	.service-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
		box-shadow: 0 12px 24px -12px rgba(37, 99, 235, 0.25);
	}
	.service-icon {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: #eff6ff;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.3rem;
		margin-bottom: 20px;
	}
	.service-card h3 { font-size: 1.1rem; margin-bottom: 10px; }
	.service-card p { color: var(--text-muted); font-size: 0.92rem; margin: 0; }
</style>
